# ----------------------------------------------------
# Arquivo de Propriedades para os Testes Playwright
# ----------------------------------------------------

# Controle da gravação de vídeos.
# Altere para 'true' para gravar vídeos de todos os testes.
# Altere para 'false' para desativar a gravação.
RECORD_VIDEO=false
# ============================================================
# Parâmetros de execução dos testes (lidos pelo playwright.config.ts)
# Valores definidos no shell (ex: TEST_ZOOM=0.9 npm test) vencem estes.
# ============================================================

# Navegadores que rodam: bdd (Chrome headless, padrao) | bdd-headed | edge | firefox | chromium
# Varios de uma vez: TEST_PROJECT=edge,bdd   |   Todos: TEST_PROJECT=all
TEST_PROJECT=bdd

# Quantidade de testes iniciados em paralelo (workers). Vazio = padrao do Playwright.
TEST_WORKERS=1

# Zoom da tela: 1 = 100%, 0.9 = 90% (mais afastado), 1.25 = 125% (mais perto). Nao afeta Firefox.
TEST_ZOOM=1

# Tamanho da janela nos projetos headless (LARGURAxALTURA). Vazio = padrao de cada project.
TEST_VIEWPORT=

# Velocidade da execucao em ms de espera apos cada acao (projetos headed). 0 = sem espera.
TEST_SLOWMO=400

# URL da aplicacao sob teste
TEST_BASE_URL=http://localhost:3000

# Janelas lado a lado (2+ navegadores visiveis: bdd-headed, edge)
TEST_SCREEN_SIZE=1920x1080
TEST_WINDOW_POSITION=
TEST_WINDOW_SIZE=

# TEST_ENV=staging|production carrega .env.<TEST_ENV> por cima deste — vazio = só local
TEST_ENV=