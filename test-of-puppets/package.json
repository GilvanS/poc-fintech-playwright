{
  "name": "test-of-puppets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestão de planos de execução de testes (poc-fintech-playwright)",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "semear": "tsx server/scripts/semear-plano.ts",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --import tsx --test \"server/tests/**/*.test.ts\"",
    "test:web": "vitest run --config vite.config.ts",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
